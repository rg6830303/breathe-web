# Breathe Pickleball — environment variables.
# Copy to .env.local for local dev, and set the same keys in Vercel for prod.
# NEVER commit real values. Only NEXT_PUBLIC_* are exposed to the browser and
# must never hold secrets.

# ── Database ────────────────────────────────────────────────────────────────
# Primary DB. If POSTGRES_URL (Supabase) is set, the app uses Postgres; otherwise
# it falls back to Turso. Use the Supabase POOLED connection string (port 6543).
POSTGRES_URL=
# Legacy / fallback (optional once fully migrated to Supabase):
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Supabase REST (only needed for the legacy mirror; leave blank when on Postgres):
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Auth / sessions ─────────────────────────────────────────────────────────
SESSION_SECRET=            # 32+ random chars — signs JWT session cookies
ADMIN_EMAIL=               # admin login email + where booking alerts go
ADMIN_PASSWORD_HASH=       # bcrypt hash (cost >= 12) of the admin password
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ── Google OAuth (optional) ─────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Payments (Razorpay) ─────────────────────────────────────────────────────
NEXT_PUBLIC_RAZORPAY_KEY_ID=   # publishable key id — safe in the browser
RAZORPAY_KEY_SECRET=           # SECRET — server only

# ── Email (Resend preferred, Gmail SMTP fallback) ───────────────────────────
RESEND_API_KEY=
GMAIL_USER=
GMAIL_APP_PASSWORD=
REPLY_TO_EMAIL=breathepickleball@gmail.com

# ── Web push notifications (VAPID) ──────────────────────────────────────────
# Public key is baked into the app; set the PRIVATE key to enable delivery.
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:breathepickleball@gmail.com
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=   # only if you rotate the keypair

# ── Integrations / misc ─────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
INSTAGRAM_ACCESS_TOKEN=
GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_SITE_URL=https://www.breathepickleball.in
# NEXT_PUBLIC_ADMIN_HOST=        # optional: host that serves the admin console
