# Breathe Pickleball — environment variables.
# Copy to .env.local for local dev, and set the same keys in Vercel for prod.
# NEVER commit real values. Only NEXT_PUBLIC_* are exposed to the browser and
# must never hold secrets.

# ── Database ────────────────────────────────────────────────────────────────
# Primary DB. If POSTGRES_URL (Supabase) is set, the app uses Postgres; otherwise
# it falls back to Turso. Use the Supabase POOLED connection string (port 6543).
POSTGRES_URL=
# Legacy / fallback (optional once fully migrated to Supabase):
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Supabase REST (only needed for the legacy mirror; leave blank when on Postgres):
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Set automatically when a Vercel Blob store is attached. Tournament
# entry photos go to Blob when present; without it they are stored inline on the
# registration row instead, so registration still works either way.
BLOB_READ_WRITE_TOKEN=

# Retired captain host. Requests to it are forwarded to the captain page on the
# main domain, so links already shared keep working. Defaults to
# 33showdown.vercel.app.
NEXT_PUBLIC_CAPTAIN_HOST=

# ── Auth / sessions ─────────────────────────────────────────────────────────
SESSION_SECRET=            # 32+ random chars — signs JWT session cookies
ADMIN_EMAIL=               # admin login email + where booking alerts go
ADMIN_PASSWORD_HASH=       # bcrypt hash (cost >= 12) of the admin password
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ── Google OAuth (optional) ─────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Payments (Razorpay) ─────────────────────────────────────────────────────
NEXT_PUBLIC_RAZORPAY_KEY_ID=   # publishable key id — safe in the browser
RAZORPAY_KEY_SECRET=
# Signing secret for the Razorpay webhook (Dashboard → Settings → Webhooks,
# <site>/api/webhooks/razorpay, event payment.captured). Without it a captured
# payment is only recorded if the entrant's browser completes the handshake.
RAZORPAY_WEBHOOK_SECRET=           # SECRET — server only

# Invite coupon that unlocks "pay cash at the venue" on the tournament entry
# form, instead of Razorpay. Checked server-only (lib/tournaments/cash-coupon.ts)
# — never sent to the browser. Optional: defaults to "CLOSEFRIEND" if unset.
# TOURNAMENT_CASH_COUPON=

# ── Email (Resend preferred, Gmail SMTP fallback) ───────────────────────────
RESEND_API_KEY=
GMAIL_USER=
GMAIL_APP_PASSWORD=
REPLY_TO_EMAIL=breathepickleball@gmail.com

# ── Web push notifications (VAPID) ──────────────────────────────────────────
# Public key is baked into the app; set the PRIVATE key to enable delivery.
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:breathepickleball@gmail.com
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=   # only if you rotate the keypair

# ── Integrations / misc ─────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
INSTAGRAM_ACCESS_TOKEN=
GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_SITE_URL=https://www.breathepickleball.in
# NEXT_PUBLIC_ADMIN_HOST=        # optional: host that serves the admin console
# Meta (Facebook) Pixel for ad traffic tracking. The ID is PUBLIC (it ships in
# the page source), not a secret. OPTIONAL — the live ID is the built-in default,
# so tracking works without setting this. Set it only to point at a different
# pixel (e.g. a staging/test pixel).
# NEXT_PUBLIC_META_PIXEL_ID=1083171524398058
